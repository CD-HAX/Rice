# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#121212"

# Main text color
theme[main_fg]="#ffffff"

# Title color for boxes
theme[title]="#ffffff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#5d7dc7"

# Background color of selected item in processes box. #ffffff maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #2a2a2a gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#2a2a2a"

# Foreground color of selected item in processes box. Use #ffffff so
# the row text stays readable on the lighter_bg highlight; the previous
# #5d7dc7 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#ffffff"

# Color of inactive/disabled text
theme[inactive_fg]="#9e9e9e"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #ffffff caps at #ffffff when the foreground is already pure white, so we
# just bind it to #ffffff directly.
theme[graph_text]="#ffffff"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #ffffff collapsed to the main fg.
theme[meter_bg]="#2a2a2a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #4b9b9b for a distinct accent instead of #ffffff which capped to white.
theme[proc_misc]="#4b9b9b"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#cd577c"
theme[mem_box]="#699b4b"
theme[net_box]="#e54743"
theme[proc_box]="#5d7dc7"

# Box divider line and small boxes line color
theme[div_line]="#9e9e9e"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#699b4b"
theme[temp_mid]="#979b4b"
theme[temp_end]="#e54743"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#4b9b9b"
theme[cpu_mid]="#5d7dc7"
theme[cpu_end]="#cd577c"

# Mem/Disk free meter
theme[free_start]="#cd577c"
theme[free_mid]="#5d7dc7"
theme[free_end]="#4b9b9b"

# Mem/Disk cached meter
theme[cached_start]="#5d7dc7"
theme[cached_mid]="#4b9b9b"
theme[cached_end]="#cd577c"

# Mem/Disk available meter
theme[available_start]="#979b4b"
theme[available_mid]="#e54743"
theme[available_end]="#e54743"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#699b4b"
theme[used_mid]="#4b9b9b"
theme[used_end]="#5d7dc7"

# Download graph colors
theme[download_start]="#979b4b"
theme[download_mid]="#e54743"
theme[download_end]="#e54743"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#699b4b"
theme[upload_mid]="#4b9b9b"
theme[upload_end]="#5d7dc7"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#4b9b9b"
theme[process_mid]="#5d7dc7"
theme[process_end]="#cd577c"
